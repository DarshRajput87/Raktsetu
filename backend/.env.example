MONGO_URI=mongodb://localhost:27017
DB_NAME=raktsetu
JWT_SECRET=change-me-to-a-long-random-string
SEARCH_RADIUS_KM=25
# "Today" for expiry and eligibility checks (YYYY-MM-DD). Leave empty to use the real date.
# The generated data uses 2026-11-13.
AS_OF_DATE=2026-11-13
# development: OTPs are returned in the response and logged (no SMS provider yet).
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
# How many city road graphs to keep in memory (LRU cache). 7 = every Gujarat city (about 700 MB).
CITY_CACHE_CAPACITY=7
# Return the login code in the /auth/otp/send response. Empty = only in development.
# A public demo without an SMS provider sets SHOW_OTP=true. Never on a real deployment.
SHOW_OTP=
