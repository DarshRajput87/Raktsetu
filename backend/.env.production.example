# Copy to backend/.env.production for `npm run backend-prod` (the API on your computer, against
# MongoDB Atlas). Never commit the copy. Render does not read it: set these in the Render dashboard.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=raktsetu
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<64 random hex characters>
ENVIRONMENT=production
# No SMS provider is connected, so the login code is shown on screen.
SHOW_OTP=true
# The live site and the local frontend may both call this API.
FRONTEND_ORIGIN=https://raktsetu.zorvx.shop,http://localhost:3000
AS_OF_DATE=2026-11-13
SEARCH_RADIUS_KM=25
# Atlas holds Ahmedabad and Vadodara.
CITY_CACHE_CAPACITY=2
