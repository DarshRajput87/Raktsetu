{
  "name": "raktsetu",
  "private": true,
  "description": "Task runner for RaktSetu (same targets as the Makefile).",
  "scripts": {
    "backend-dev": "cd backend && .venv\\Scripts\\python serve.py dev",
    "backend-prod": "cd backend && .venv\\Scripts\\python serve.py prod",
    "frontend-dev": "cd frontend && npm run dev",
    "test": "npm run test-backend && npm run test-e2e",
    "test-backend": "cd backend && .venv\\Scripts\\python -m pytest -q",
    "test-e2e": "cd frontend && npx playwright test",
    "bench": "cd backend && .venv\\Scripts\\python -m benchmarks.bench_core",
    "simulate": "cd backend && .venv\\Scripts\\python -m simulation.simulator --days 90 --runs 10",
    "seed": "cd backend && .venv\\Scripts\\python -m db.seed --reset"
  }
}
